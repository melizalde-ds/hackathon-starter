# The app name placeholder below is filled in by scripts/deploy.sh.
[Unit]
Description=APP_NAME
After=network-online.target
Wants=network-online.target

[Service]
User=APP_NAME
EnvironmentFile=/etc/APP_NAME.env
WorkingDirectory=/srv/APP_NAME
# The service listens on 127.0.0.1:3000. Keep the ExecStart for your stack.
# Rust:
ExecStart=/srv/APP_NAME/server
# Python (set the module for your app):
# ExecStart=/srv/APP_NAME/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 3000 --app-dir /srv/APP_NAME/server
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
