# Copy to .env and fill in. Add a line here every time you add a key.

# Model (.claude/rules/bedrock.md). "scripted" runs the demo with no model.
LLM_PROVIDER=scripted
BEDROCK_MODEL_ID=
# Fallback provider for when Bedrock is out
ANTHROPIC_API_KEY=

# AWS: run as the hackathon profile, in the demo region
AWS_PROFILE=hackathon
AWS_REGION=us-west-2
# Lightsail only: the hackathon-app user's keys, copied to the box by scripts/deploy.sh
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# Qdrant: Docker locally and on the box, same URL in both
QDRANT_URL=http://localhost:6333
